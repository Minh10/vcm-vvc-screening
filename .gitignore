# VTM is fetched by scripts/fetch_vtm.sh, never committed
third_party/VTM
third_party/VTM/
third_party/VTM_BUILD_INFO

# Large media and codec outputs
*.yuv
*.y4m
*.bin
*.266
*.vvc
results/**/raw/
results/p0/smoke_*/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# OS / editor
.DS_Store
.vscode/
.idea/

# hook dumps / weight maps / per-run raw outputs
*.y16
*.f32
results/hooks/
# per-job hook inputs/outputs referenced by configs/variants.yaml
results/b1/dump/
results/b1/weights/
results/b1/external/
results/ramu/trace/
results/e2e/
# per-checkout provenance written by scripts/fetch_vtm.sh (the pin is third_party/vtm_patch/EXPECTED_TREE)
third_party/VTM_COMMIT
third_party/VTM_PROVENANCE
# bulky per-run outputs (share results with `python -m vcm.export`)
results/**/traces/
results/**/offsets/
results/**/*.log
results/**/detections.json
