+// VCM screening: one CSV row per final luma CU of the CTU (format documented in vcm-vvc-screening, vcm/ramu/graph.py)
+void EncSlice::vcmTraceCtu(const CodingStructure &cs, const UnitArea &ctuArea, const Slice &slice)
+{
+  if (!m_vcmTrace.is_open())
+  {
+    m_vcmTrace.open(m_pcCfg->getVcmTraceFile());
+    CHECK(!m_vcmTrace.is_open(), "VCMTraceFile cannot be opened: " + m_pcCfg->getVcmTraceFile());
+    m_vcmTrace << "poc,coding_order,temporal_id,x,y,w,h,qp,mode,ref_poc0,mv0x,mv0y,ref_poc1,mv1x,mv1y,resid_energy,"
+                  "flags,mv_spread,ref_mixed\n";
+  }
+  const int poc = slice.getPOC();
+  auto      ord = m_vcmCodingOrder.find(poc);
+  if (ord == m_vcmCodingOrder.end())
+  {
+    ord = m_vcmCodingOrder.emplace(poc, (int) m_vcmCodingOrder.size()).first;
+  }
+  const double mvScale = 1.0 / double(1 << MV_FRACTIONAL_BITS_INTERNAL);
+
+  for (const CodingUnit &cu: cs.traverseCUs(ctuArea, ChannelType::LUMA))
+  {
+    const bool  intraLike = CU::isIntra(cu) || CU::isIBC(cu) || CU::isPLT(cu);
+    const char *mode      = intraLike ? "intra" : (cu.skip ? "skip" : "inter");
+    int         refPoc[2] = { -1, -1 };
+    double      mv[2][2]  = { { 0.0, 0.0 }, { 0.0, 0.0 } };
+    double      mvSpread  = 0.0;   // max |subblock MV - centre MV| (luma samples, L-inf) over the CU's 4x4 grid
+    int         refMixed  = 0;     // 4x4 subblocks whose reference picture / list usage differs from the centre
+    std::string flags;
+    auto        addFlag = [&flags](const char *f) { flags += (flags.empty() ? "" : "|") + std::string(f); };
+    if (CU::isIBC(cu))
+    {
+      addFlag("ibc");
+    }
+    if (CU::isPLT(cu))
+    {
+      addFlag("plt");
+    }
+    if (!intraLike && cu.firstPU != nullptr)
+    {
+      const PredictionUnit &pu = *cu.firstPU;
+      if (cu.affine)
+      {
+        addFlag(cu.affineType == AffineModel::_6_PARAMS ? "affine6" : "affine4");
+      }
+      if (cu.geoFlag)
+      {
+        addFlag("geo");
+      }
+      if (pu.ciipFlag)
+      {
+        addFlag("ciip");
+      }
+      if (pu.mmvdMergeFlag)
+      {
+        addFlag("mmvd");
+      }
+      // Motion as stored in the picture's motion field (what later pictures and the decoder see per 4x4 unit):
+      // the centre sample gives the translational approximation for affine and GEO CUs as well.
+      const CompArea   &ya     = cu.Y();
+      const Position    centre(ya.x + ya.width / 2, ya.y + ya.height / 2);
+      const MotionInfo &mc     = cs.getMotionInfo(centre);
+      for (int l = 0; l < NUM_REF_PIC_LIST_01; l++)
+      {
+        if ((mc.interDir & (1 << l)) && mc.refIdx[l] >= 0)
+        {
+          refPoc[l] = slice.getRefPOC(RefPicList(l), mc.refIdx[l]);
+          mv[l][0]  = mc.mv[l].getHor() * mvScale;
+          mv[l][1]  = mc.mv[l].getVer() * mvScale;
+        }
+      }
+      for (int y = ya.y; y < ya.y + (int) ya.height; y += 4)
+      {
+        for (int x = ya.x; x < ya.x + (int) ya.width; x += 4)
+        {
+          const MotionInfo &m = cs.getMotionInfo(Position(x, y));
+          if (m.interDir != mc.interDir)
+          {
+            refMixed++;
+            continue;
+          }
+          bool differs = false;
+          for (int l = 0; l < NUM_REF_PIC_LIST_01; l++)
+          {
+            if (!(m.interDir & (1 << l)))
+            {
+              continue;
+            }
+            if (m.refIdx[l] != mc.refIdx[l])
+            {
+              differs = true;
+              continue;
+            }
+            mvSpread = std::max(mvSpread, std::abs(m.mv[l].getHor() - mc.mv[l].getHor()) * mvScale);
+            mvSpread = std::max(mvSpread, std::abs(m.mv[l].getVer() - mc.mv[l].getVer()) * mvScale);
+          }
+          refMixed += differs ? 1 : 0;
+        }
+      }
+    }
+    double resid = 0.0;
+    for (const TransformUnit &tu: CU::traverseTUs(cu))
+    {
+      if (!tu.blocks[COMPONENT_Y].valid() || !TU::getCbf(tu, COMPONENT_Y))
+      {
+        continue;
+      }
+      const CCoeffBuf c = tu.getCoeffs(COMPONENT_Y);
+      for (int y = 0; y < (int) c.height; y++)
+      {
+        for (int x = 0; x < (int) c.width; x++)
+        {
+          resid += std::abs(c.at(x, y));
+        }
+      }
+    }
+    const CompArea &a = cu.Y();
+    m_vcmTrace << poc << ',' << ord->second << ',' << slice.getTLayer() << ',' << a.x << ',' << a.y << ','
+               << a.width << ',' << a.height << ',' << static_cast<int>(cu.qp) << ',' << mode << ',' << refPoc[0] << ',' << mv[0][0]
+               << ',' << mv[0][1] << ',' << refPoc[1] << ',' << mv[1][0] << ',' << mv[1][1] << ',' << resid << ','
+               << flags << ',' << mvSpread << ',' << refMixed << '\n';
+  }
+}
