+// ---------------------------------------------------------------------------------------------------------------------
+// VCM screening hooks (github.com/Minh10/vcm-vvc-screening). Inactive unless the corresponding option is set.
+// ---------------------------------------------------------------------------------------------------------------------
+
+void EncAdaptiveLoopFilter::vcmLoadWeights(int poc)
+{
+  m_vcmWeight.clear();
+  const std::string &dir = m_encCfg->getVcmAlfWeightDir();
+  if (dir.empty())
+  {
+    return;
+  }
+  const std::string path = dir + "/w_" + std::to_string(poc) + ".f32";
+  std::ifstream     f(path, std::ios::binary);
+  // a missing map would silently fall back to unweighted statistics and contaminate the comparison
+  CHECK(!f.is_open(), "VCMAlfWeightDir: missing weight map " + path);
+  m_vcmWeight.resize((size_t) m_picWidth * m_picHeight);
+  f.read(reinterpret_cast<char *>(m_vcmWeight.data()), (std::streamsize) (m_vcmWeight.size() * sizeof(float)));
+  CHECK(f.gcount() != (std::streamsize) (m_vcmWeight.size() * sizeof(float)),
+        "VCMAlfWeightDir: weight map has the wrong size (expected luma width x height float32): " + path);
+  CHECK(f.peek() != std::char_traits<char>::eof(),
+        "VCMAlfWeightDir: weight map is larger than luma width x height float32: " + path);
+  for (const float w: m_vcmWeight)
+  {
+    CHECK(!(std::isfinite(w) && w >= 0.0f), "VCMAlfWeightDir: weights must be finite and non-negative: " + path);
+  }
+}
+
+bool EncAdaptiveLoopFilter::vcmApplyExternal(int poc, AlfParam &alfParam)
+{
+  const std::string &file = m_encCfg->getVcmAlfExternalFile();
+  if (file.empty())
+  {
+    return false;
+  }
+  constexpr int numVals = 2 * (MAX_NUM_ALF_LUMA_COEFF - 1);   // 12 coefficients + 12 clipping indices per class
+  if (!m_vcmExternalLoaded)
+  {
+    std::ifstream f(file);
+    CHECK(!f.is_open(), "VCMAlfExternalFile cannot be opened: " + file);
+    std::string line;
+    CHECK(!std::getline(f, line) || line.rfind("# vcm-alf-luma-txt-v1", 0) != 0,
+          "VCMAlfExternalFile: missing '# vcm-alf-luma-txt-v1' header");
+    while (std::getline(f, line))
+    {
+      if (line.find_first_not_of(" \t\r") == std::string::npos)
+      {
+        continue;
+      }
+      std::istringstream head(line);
+      std::string        tag;
+      int                p = 0;
+      CHECK(!(head >> tag >> p) || tag != "POC", "VCMAlfExternalFile: expected 'POC <n>', got: " + line);
+      CHECK(m_vcmExternal.count(p) != 0, "VCMAlfExternalFile: duplicate POC " + std::to_string(p));
+      std::vector<int> v(MAX_NUM_ALF_CLASSES * numVals);
+      for (int c = 0; c < MAX_NUM_ALF_CLASSES; c++)
+      {
+        CHECK(!std::getline(f, line), "VCMAlfExternalFile: truncated block for POC " + std::to_string(p));
+        std::istringstream row(line);
+        for (int k = 0; k < numVals; k++)
+        {
+          CHECK(!(row >> v[c * numVals + k]), "VCMAlfExternalFile: expected 24 integers per class, POC "
+                                                  + std::to_string(p) + " class " + std::to_string(c));
+        }
+      }
+      m_vcmExternal[p] = v;
+    }
+    m_vcmExternalLoaded = true;
+  }
+  const auto it = m_vcmExternal.find(poc);
+  if (it == m_vcmExternal.end())
+  {
+    return false;   // pictures not listed keep the standard VTM decisions
+  }
+  const std::vector<int> &v = it->second;
+  bool nonLinear = false;
+  alfParam.enabledFlag[COMPONENT_Y] = true;
+  alfParam.numLumaFilters           = MAX_NUM_ALF_CLASSES;   // one filter per class, no merging
+  alfParam.alfLumaCoeffDeltaFlag    = false;
+  for (int c = 0; c < MAX_NUM_ALF_CLASSES; c++)
+  {
+    alfParam.filterCoeffDeltaIdx[c] = c;
+    alfParam.alfLumaCoeffFlag[c]    = true;
+    for (int k = 0; k < MAX_NUM_ALF_LUMA_COEFF - 1; k++)
+    {
+      const int coeff = v[c * numVals + k];
+      const int clip  = v[c * numVals + MAX_NUM_ALF_LUMA_COEFF - 1 + k];
+      CHECK(coeff < -128 || coeff > 127, "VCMAlfExternalFile: luma coefficient out of [-128, 127]");
+      CHECK(clip < 0 || clip >= ALF_NUM_CLIP_VALS[ChannelType::LUMA], "VCMAlfExternalFile: clipping index out of range");
+      alfParam.lumaCoeff[c * MAX_NUM_ALF_LUMA_COEFF + k] = coeff;
+      alfParam.lumaClipp[c * MAX_NUM_ALF_LUMA_COEFF + k] = clip;
+      nonLinear |= clip != 0;
+    }
+    alfParam.lumaCoeff[c * MAX_NUM_ALF_LUMA_COEFF + MAX_NUM_ALF_LUMA_COEFF - 1] = 0;
+    alfParam.lumaClipp[c * MAX_NUM_ALF_LUMA_COEFF + MAX_NUM_ALF_LUMA_COEFF - 1] = 0;
+  }
+  alfParam.nonLinearFlag[ChannelType::LUMA] = nonLinear;
+  return true;
+}
+
+void EncAdaptiveLoopFilter::vcmDump(CodingStructure &cs, const PelUnitBuf &orgYuv, const PelUnitBuf &preAlf)
+{
+  const std::string &dir = m_encCfg->getVcmAlfDumpDir();
+  const std::string  poc = std::to_string(cs.slice->getPOC());
+  {
+    std::ofstream meta(dir + "/meta.txt");
+    CHECK(!meta.is_open(), "VCMAlfDumpDir is not writable: " + dir);
+    meta << "width " << m_picWidth << "\nheight " << m_picHeight << "\nbitdepth "
+         << m_inputBitDepth[ChannelType::LUMA] << "\nctu_size " << m_maxCUHeight << "\nvb_pos " << m_alfVBLumaPos
+         << "\n";
+  }
+  auto writePlane = [&](const std::string &name, const CPelBuf &buf)
+  {
+    std::ofstream f(dir + "/" + name, std::ios::binary);
+    std::vector<int16_t> row(buf.width);
+    for (int y = 0; y < (int) buf.height; y++)
+    {
+      for (int x = 0; x < (int) buf.width; x++)
+      {
+        row[x] = (int16_t) buf.at(x, y);
+      }
+      f.write(reinterpret_cast<const char *>(row.data()), (std::streamsize) (row.size() * sizeof(int16_t)));
+    }
+  };
+  writePlane("pre_" + poc + ".y16", preAlf.get(COMPONENT_Y));
+  writePlane("post_" + poc + ".y16", cs.getRecoBuf().get(COMPONENT_Y));
+  writePlane("org_" + poc + ".y16", orgYuv.get(COMPONENT_Y));
+
+  std::ofstream t(dir + "/ctb_" + poc + ".txt");
+  const bool lumaOn = cs.slice->getAlfEnabledFlag(COMPONENT_Y);
+  t << "# vcm-alf-ctb-v1 poc " << poc << " luma_enabled " << (lumaOn ? 1 : 0) << "\n";
+  for (int ctb = 0; ctb < m_numCTUsInPic; ctb++)
+  {
+    const AlfMode m = lumaOn ? m_modes[COMPONENT_Y][ctb] : AlfMode::OFF;
+    t << "CTB " << ctb << " " << static_cast<int>(to_underlying(m)) << "\n";
+    if (m == AlfMode::OFF)
+    {
+      continue;
+    }
+    const AlfCoeff *coeff = getCoeffVals(m);
+    const Pel      *clip  = getClipVals(m);
+    for (int c = 0; c < MAX_NUM_ALF_CLASSES; c++)
+    {
+      for (int k = 0; k < MAX_NUM_ALF_LUMA_COEFF - 1; k++)
+      {
+        t << coeff[c * MAX_NUM_ALF_LUMA_COEFF + k] << ' ';
+      }
+      for (int k = 0; k < MAX_NUM_ALF_LUMA_COEFF - 1; k++)
+      {
+        t << clip[c * MAX_NUM_ALF_LUMA_COEFF + k] << (k + 1 < MAX_NUM_ALF_LUMA_COEFF - 1 ? ' ' : '\n');
+      }
+    }
+  }
+}
